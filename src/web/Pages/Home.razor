@page "/"
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using web.Services
@using System.Globalization
@inject AuthService Auth
@inject PhotoService Photos
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Home> Logger

<PageTitle>Longevity</PageTitle>

@if (Auth.State.IsAuthenticated)
{
    @if (_photos is null)
    {
        <p>Loading photos...</p>
    }
    else
    {
        <div class="calendar-toggle-row">
            <button class="btn-all @(_selectedDay is null && _selectedGroupName is null ? "active" : "")" @onclick="() => ClearFilters()">All</button>
            <button class="calendar-toggle" @onclick="ToggleCalendar">
                @CalendarButtonLabel()
            </button>

            <div class="category-filter">
                <select @onchange="OnGroupNameFilterChanged">
                    <option value="" selected="@(_selectedGroupName is null)">All groups</option>
                    @foreach (var name in _allGroupNames)
                    {
                        <option value="@name" selected="@(_selectedGroupName == name)">@name</option>
                    }
                </select>
            </div>

            @if (_nextBefore is not null)
            {
                <button class="btn-all" @onclick="LoadMoreAsync" disabled="@_loadingMore">
                    @(_loadingMore ? "Loading..." : "Load more")
                </button>
            }

            <CalendarPopup IsOpen="_calendarOpen"
                           SelectedDay="_selectedDay"
                           PhotoCounts="_photoCounts"
                           Toggle="ToggleCalendar"
                           OnSelectDay="SelectDate" />
        </div>

        @if (_photos.Count == 0)
        {
            <p style="margin-top: 1rem;">@(_selectedDay is null ? "No photos yet." : "No photos for selected day.")</p>
        }
        else
        {
            @foreach (var groupNode in RootGroups())
            {
                <RootGroupSection Node="groupNode"
                                  Names="GetGroupNames(groupNode.GroupId)"
                                  AllGroupNames="_allGroupNames"
                                  Photos="GroupPhotos(groupNode)"
                                  Children="ChildGroups(groupNode.GroupId)"
                                  PhotosByName="_photosByName"
                                  ChildrenByParent="_childrenByParent"
                                  IsGroupVisible="IsGroupVisible"
                                  OnStartDrag="StartDrag"
                                  OnEndDrag="EndDrag"
                                  OnDropOnPhoto="DropOn"
                                  OnDropIntoGroup="DropIntoGroup"
                                  OnOpenLightbox="OpenLightbox"
                                  OnUngroup="UngroupPhoto"
                                  OnDelete="DeletePhoto"
                                  OnAssignName="AssignName"
                                  OnRemoveName="RemoveName" />
            }

            @if (UngroupedPhotos().Length > 0)
            {
                <section class="group-section">
                    <h2>Ungrouped</h2>
                    <div class="photo-grid">
                        @foreach (var photo in UngroupedPhotos())
                        {
                            <PhotoCard Photo="photo"
                                       OnStartDrag="StartDrag"
                                       OnEndDrag="EndDrag"
                                       OnDrop="DropOn"
                                       OnClick="OpenLightbox"
                                       OnUngroup="UngroupPhoto"
                                       OnDelete="DeletePhoto" />
                        }
                    </div>
                </section>
            }

            @if (_nextBefore is not null)
            {
                <div style="text-align: center; margin-top: 1rem;">
                    <button class="btn-all" @onclick="LoadMoreAsync" disabled="@_loadingMore">
                        @(_loadingMore ? "Loading..." : "Load more")
                    </button>
                </div>
            }
        }
    }
}

@if (_lightboxPhoto is not null)
{
    <div class="lightbox" @onclick="CloseLightbox">
        <button class="lightbox-close" aria-label="Close" @onclick="CloseLightbox" @onclick:stopPropagation>&times;</button>
        <img src="@_lightboxPhoto.Url" alt="@_lightboxPhoto.Name" @onclick:stopPropagation />
    </div>
}

@code {
    private List<PhotoInfo>? _photos;
    private string? _nextBefore;
    private bool _loadingMore;
    private HubConnection? _hubConnection;
    private GroupTreeNodeDto[] _groupTree = [];
    private Dictionary<string, GroupTreeNodeDto[]> _childrenByParent = [];
    private Dictionary<string, PhotoInfo> _photosByName = [];
    private string? _draggedPhotoName;
    private DateTime? _selectedDay;
    private PhotoInfo? _lightboxPhoto;
    private IJSObjectReference? _touchModule;
    private DotNetObjectReference<Home>? _dotNetRef;
    private bool _calendarOpen;

    private string[] _allGroupNames = [];
    private Dictionary<string, string[]> _groupNameAssignments = [];
    private Dictionary<DateOnly, int> _photoCounts = [];
    private string? _selectedGroupName;

    protected override async Task OnInitializedAsync()
    {
        await Auth.CheckAsync();
        if (Auth.State.IsAuthenticated)
        {
            await ReloadAsync();

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/photos"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On("PhotosChanged", async () =>
            {
                await ReloadAsync();
                await InvokeAsync(StateHasChanged);
            });

            try { await _hubConnection.StartAsync(); }
            catch (Exception ex) { Logger.LogWarning(ex, "SignalR hub connection failed; real-time updates unavailable"); }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _touchModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/touch-drag.js");
            await _touchModule.InvokeVoidAsync("init", _dotNetRef);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"touch-drag init failed: {ex.Message}");
            _touchModule = null;
        }
    }

    [JSInvokable]
    public async Task DropOnFromTouch(string sourceName, string targetName)
    {
        if (await Photos.GroupAsync(sourceName, targetName))
        {
            await RefreshGroupsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task DropIntoGroupFromTouch(string sourceName, string targetGroupId)
    {
        if (await Photos.MovePhotoToGroupAsync(sourceName, targetGroupId))
        {
            await RefreshGroupsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadAsync()
    {
        var date = _selectedDay.HasValue ? DateOnly.FromDateTime(_selectedDay.Value) : (DateOnly?)null;
        _photos = null;
        _nextBefore = null;
        var page = await Photos.LoadPageAsync(date: date, groupName: _selectedGroupName);
        _photos = [..page.Items];
        _nextBefore = page.NextBefore;
        _groupTree = await Photos.LoadGroupTreeAsync();
        _childrenByParent = _groupTree
            .Where(node => !string.IsNullOrWhiteSpace(node.ParentGroupId))
            .GroupBy(node => node.ParentGroupId!)
            .ToDictionary(g => g.Key, g => g.ToArray());
        _photosByName = (_photos ?? [])
            .ToDictionary(photo => photo.Name, StringComparer.Ordinal);
        _allGroupNames = await Photos.LoadGroupNamesAsync();
        _groupNameAssignments = await Photos.LoadGroupNameAssignmentsAsync();
        _photoCounts = await Photos.LoadPhotoCountsAsync();
    }

    private async Task RefreshGroupsAsync()
    {
        _groupTree = await Photos.LoadGroupTreeAsync();
        _childrenByParent = _groupTree
            .Where(node => !string.IsNullOrWhiteSpace(node.ParentGroupId))
            .GroupBy(node => node.ParentGroupId!)
            .ToDictionary(g => g.Key, g => g.ToArray());
        _groupNameAssignments = await Photos.LoadGroupNameAssignmentsAsync();
        _allGroupNames = await Photos.LoadGroupNamesAsync();
    }

    private async Task LoadMoreAsync()
    {
        if (_nextBefore is null || _loadingMore) return;
        _loadingMore = true;
        try
        {
            var date = _selectedDay.HasValue ? DateOnly.FromDateTime(_selectedDay.Value) : (DateOnly?)null;
            var page = await Photos.LoadPageAsync(before: _nextBefore, date: date, groupName: _selectedGroupName);
            _photos!.AddRange(page.Items);
            _photosByName = _photos.ToDictionary(photo => photo.Name, StringComparer.Ordinal);
            _nextBefore = page.NextBefore;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    // ── Derived data ─────────────────────────────────────────

    private bool HasVisiblePhotos(GroupTreeNodeDto node) =>
        GroupPhotos(node).Length > 0
        || ChildGroups(node.GroupId).Any(HasVisiblePhotos);

    private GroupTreeNodeDto[] RootGroups() =>
        _groupTree
            .Where(node =>
                string.IsNullOrWhiteSpace(node.ParentGroupId)
                && IsGroupVisible(node.GroupId)
                && HasVisiblePhotos(node))
            .Select(node => new { node, photos = GroupPhotos(node) })
            .OrderByDescending(x => x.photos.Length > 0
                ? x.photos[0].LastModified
                : DateTimeOffset.MinValue)
            .Select(x => x.node)
            .ToArray();

    private GroupTreeNodeDto[] ChildGroups(string groupId) =>
        _childrenByParent.TryGetValue(groupId, out var children) ? children : [];

    private PhotoInfo[] GroupPhotos(GroupTreeNodeDto node) =>
        node.Photos
            .Where(_photosByName.ContainsKey)
            .Select(name => _photosByName[name])
            .OrderByDescending(photo => photo.LastModified)
            .ToArray();

    private PhotoInfo[] UngroupedPhotos()
    {
        if (_selectedGroupName is not null) return [];
        var groupedNames = _groupTree.SelectMany(g => g.Photos).ToHashSet(StringComparer.Ordinal);
        return (_photos?.ToArray() ?? [])
            .Where(p => !groupedNames.Contains(p.Name))
            .OrderByDescending(p => p.LastModified)
            .ToArray();
    }

    private string[] GetGroupNames(string groupId) =>
        _groupNameAssignments.TryGetValue(groupId, out var names) ? names : [];

    private bool IsGroupVisible(string groupId)
    {
        if (_selectedGroupName is null) return true;
        return AncestorHasName(groupId, _selectedGroupName)
            || DescendantHasName(groupId, _selectedGroupName);
    }

    private bool AncestorHasName(string groupId, string name)
    {
        var current = groupId;
        while (current is not null)
        {
            if (_groupNameAssignments.TryGetValue(current, out var n) && n.Contains(name))
                return true;
            current = _groupTree.FirstOrDefault(x => x.GroupId == current)?.ParentGroupId;
        }
        return false;
    }

    private bool DescendantHasName(string groupId, string name)
    {
        var children = _childrenByParent.TryGetValue(groupId, out var c) ? c : [];
        return children.Any(child =>
            (_groupNameAssignments.TryGetValue(child.GroupId, out var n) && n.Contains(name))
            || DescendantHasName(child.GroupId, name));
    }

    // ── Filter / calendar ────────────────────────────────────

    private string CalendarButtonLabel() =>
        _selectedDay is not null
            ? _selectedDay.Value.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)
            : "Calendar";

    private void ToggleCalendar() => _calendarOpen = !_calendarOpen;

    private async Task SelectDate(DateTime day)
    {
        _selectedDay = day.Date;
        _calendarOpen = false;
        await ReloadAsync();
    }

    private async Task ClearFilters()
    {
        _selectedDay = null;
        _selectedGroupName = null;
        await ReloadAsync();
    }

    private async Task OnGroupNameFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _selectedGroupName = string.IsNullOrEmpty(val) ? null : val;
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    // ── Actions ──────────────────────────────────────────────

    private void StartDrag(string name) => _draggedPhotoName = name;
    private void EndDrag() => _draggedPhotoName = null;

    private void OpenLightbox(PhotoInfo photo)
    {
        if (!string.IsNullOrWhiteSpace(_draggedPhotoName)) return;
        _lightboxPhoto = photo;
    }

    private void CloseLightbox() => _lightboxPhoto = null;

    private async Task DropOn(string targetName)
    {
        if (string.IsNullOrWhiteSpace(_draggedPhotoName) || _draggedPhotoName == targetName)
        { _draggedPhotoName = null; return; }

        var source = _draggedPhotoName;
        _draggedPhotoName = null;
        if (await Photos.GroupAsync(source, targetName))
            await RefreshGroupsAsync();
    }

    private async Task DropIntoGroup(string targetGroupId)
    {
        if (string.IsNullOrWhiteSpace(_draggedPhotoName))
        { _draggedPhotoName = null; return; }

        var source = _draggedPhotoName;
        _draggedPhotoName = null;
        if (await Photos.MovePhotoToGroupAsync(source, targetGroupId))
            await RefreshGroupsAsync();
    }

    private async Task DeletePhoto(PhotoInfo photo)
    {
        if (await Photos.DeleteAsync(photo.Name))
        {
            _photos?.RemoveAll(p => p.Name == photo.Name);
            _photosByName.Remove(photo.Name);
            await ReloadAsync();
        }
    }

    private async Task UngroupPhoto(PhotoInfo photo)
    {
        if (await Photos.UngroupAsync(photo.Name))
            await RefreshGroupsAsync();
    }

    private async Task AssignName((string GroupId, string Name) args)
    {
        if (await Photos.AssignGroupNameAsync(args.GroupId, args.Name))
            await RefreshGroupsAsync();
    }

    private async Task RemoveName((string GroupId, string Name) args)
    {
        if (await Photos.RemoveGroupNameAsync(args.GroupId, args.Name))
            await RefreshGroupsAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_touchModule is not null)
        {
            await _touchModule.InvokeVoidAsync("dispose");
            await _touchModule.DisposeAsync();
        }
        _dotNetRef?.Dispose();
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }
}
