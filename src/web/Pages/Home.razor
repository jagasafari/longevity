@page "/"
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using web.Services
@using System.Globalization
@inject AuthService Auth
@inject PhotoService Photos
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Home> Logger

<PageTitle>Longevity</PageTitle>

@if (Auth.State.IsAuthenticated)
{
    @if (_photos is null)
    {
        <p>Loading photos...</p>
    }
    else
    {
        <div class="calendar-toggle-row">
            <button class="btn-all @(_selectedDay is null && _selectedCategoryId is null ? "active" : "")" @onclick="() => ClearFilters()">All</button>
            <button class="calendar-toggle" @onclick="ToggleCalendar">
                @CalendarButtonLabel()
            </button>

            <div class="category-filter">
                <select @onchange="OnCategoryFilterChanged">
                    <option value="" selected="@(_selectedCategoryId is null)">All categories</option>
                    @foreach (var cat in _allCategories)
                    {
                        <option value="@cat.Id" selected="@(_selectedCategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>

            @if (_nextBefore is not null)
            {
                <button class="btn-all" @onclick="LoadMoreAsync" disabled="@_loadingMore">
                    @(_loadingMore ? "Loading..." : "Load more")
                </button>
            }

            @if (_calendarOpen)
            {
                <div class="calendar-backdrop" @onclick="ToggleCalendar"></div>
                <div class="calendar-popup">
                    <div class="calendar-header">
                        <button @onclick="PrevMonth" @onclick:stopPropagation>&lsaquo;</button>
                        <span>@_calendarMonth.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</span>
                        <button @onclick="NextMonth" @onclick:stopPropagation>&rsaquo;</button>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(7, 32px); gap: 2px; text-align: center; font-size: 0.7rem; color: #64748b; margin-bottom: 4px;">
                        <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(7, 32px); gap: 2px;">
                        @foreach (var cell in CalendarCells())
                        {
                            @if (cell is null)
                            {
                                <span style="width: 32px; height: 38px;"></span>
                            }
                            else
                            {
                                var day = cell.Value;
                                var count = GetPhotoCount(day);
                                var isSelected = _selectedDay is not null && day.Date == _selectedDay.Value.Date;
                                <button style="@DayStyle(isSelected, count > 0)" @onclick="() => SelectDate(day)" @onclick:stopPropagation>
                                    <span style="line-height: 1;">@day.Day</span>
                                    @if (count > 0)
                                    {
                                        <span style="font-size: 0.5rem; line-height: 1; margin-top: 1px;">@count</span>
                                    }
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        @if (_photos.Count == 0)
        {
            <p style="margin-top: 1rem;">@(_selectedDay is null ? "No photos yet." : "No photos for selected day.")</p>
        }
        else
        {
            @foreach (var groupNode in RootGroups())
            {
                var groupId = groupNode.GroupId;
                var group = GroupPhotos(groupNode);
                var cats = GetGroupCategoryNames(groupId);
            <section class="group-section">
                <div class="group-header"
                     data-group-id="@groupId"
                     @ondragover:preventDefault
                     @ondrop="() => DropIntoGroup(groupId)">
                    <h2>@(cats.Length > 0 ? string.Join(", ", cats) : "Group")</h2>
                    <div class="category-tags">
                        @foreach (var cat in GetGroupCategories(groupId))
                        {
                            <span class="category-tag">
                                @cat.Name
                                <button class="tag-remove" aria-label="Remove category @cat.Name" @onclick="() => RemoveGroupCategory(groupId, cat.Id)">&times;</button>
                            </span>
                        }
                    </div>
                    <div class="category-assign">
                        @if (_assigningGroupId == groupId)
                        {
                            <input class="category-input" placeholder="New or existing category..."
                                   list="category-suggestions"
                                   @bind="_categoryInput" @bind:event="oninput"
                                   @onkeydown="OnCategoryKeyDown" />
                            <datalist id="category-suggestions">
                                @foreach (var cat in _allCategories)
                                {
                                    <option value="@cat.Name" />
                                }
                            </datalist>
                            <button class="btn-tag-save" @onclick="SaveCategory">Add</button>
                            <button class="btn-tag-cancel" @onclick="() => _assigningGroupId = null">Cancel</button>
                        }
                        else
                        {
                            <button class="btn-tag-add" @onclick="() => StartAssigningCategory(groupId)">+ Category</button>
                        }
                    </div>
                </div>
                <div class="photo-grid">
                    @foreach (var photo in group)
                    {
                        <div class="photo-card"
                             data-photo-name="@photo.Name"
                             draggable="true"
                             @ondragstart="() => StartDrag(photo.Name)"
                                @ondragend="EndDrag"
                             @ondragover:preventDefault
                             @ondrop="() => DropOn(photo.Name)">
                            <img src="@(photo.ThumbnailUrl ?? photo.Url)" alt="@photo.Name" loading="lazy"
                                 @onclick="() => OpenLightbox(photo)" @onclick:stopPropagation />
                            <div class="card-actions">
                                <button class="ungroup-btn" aria-label="Ungroup @photo.Name" @onclick="() => UngroupPhoto(photo)">Ungroup</button>
                                <button class="delete-btn" aria-label="Delete @photo.Name" @onclick="() => DeletePhoto(photo)">Delete</button>
                            </div>
                        </div>
                    }
                </div>

                @if (ChildGroups(groupId).Length > 0)
                {
                    <div class="subgroups-container">
                        @foreach (var child in ChildGroups(groupId))
                        {
                            <GroupTreeNode Node="child"
                                           Depth="1"
                                           PhotosByName="_photosByName"
                                           ChildrenByParent="_childrenByParent"
                                           IsVisible="IsGroupVisible"
                                           OnStartDrag="StartDrag"
                                           OnEndDrag="EndDrag"
                                           OnDropOnPhoto="DropOn"
                                           OnDropIntoGroup="DropIntoGroup"
                                           OnOpenLightbox="OpenLightbox"
                                           OnUngroup="UngroupPhoto"
                                           OnDelete="DeletePhoto" />
                        }
                    </div>
                }
            </section>
        }

        @if (UngroupedPhotos().Length > 0)
        {
            <section class="group-section">
                <h2>Ungrouped</h2>
                <div class="photo-grid">
                    @foreach (var photo in UngroupedPhotos())
                    {
                        <div class="photo-card"
                             data-photo-name="@photo.Name"
                             draggable="true"
                             @ondragstart="() => StartDrag(photo.Name)"
                                @ondragend="EndDrag"
                             @ondragover:preventDefault
                             @ondrop="() => DropOn(photo.Name)">
                            <img src="@(photo.ThumbnailUrl ?? photo.Url)" alt="@photo.Name" loading="lazy"
                                 @onclick="() => OpenLightbox(photo)" @onclick:stopPropagation />
                            <button class="delete-btn" aria-label="Delete @photo.Name" @onclick="() => DeletePhoto(photo)">Delete</button>
                        </div>
                    }
                </div>
            </section>
        }
        @if (_nextBefore is not null)
        {
            <div style="text-align: center; margin-top: 1rem;">
                <button class="btn-all" @onclick="LoadMoreAsync" disabled="@_loadingMore">
                    @(_loadingMore ? "Loading..." : "Load more")
                </button>
            </div>
        }
        }
    }
}

@if (_lightboxPhoto is not null)
{
    <div class="lightbox" @onclick="CloseLightbox">
        <button class="lightbox-close" aria-label="Close" @onclick="CloseLightbox" @onclick:stopPropagation>&times;</button>
        <img src="@_lightboxPhoto.Url" alt="@_lightboxPhoto.Name" @onclick:stopPropagation />
    </div>
}

@code {
    private List<PhotoInfo>? _photos;
    private string? _nextBefore;
    private bool _loadingMore;
    private HubConnection? _hubConnection;
    private GroupTreeNodeDto[] _groupTree = [];
    private Dictionary<string, GroupTreeNodeDto[]> _childrenByParent = [];
    private Dictionary<string, PhotoInfo> _photosByName = [];
    private string? _draggedPhotoName;
    private DateTime? _selectedDay;
    private PhotoInfo? _lightboxPhoto;
    private IJSObjectReference? _touchModule;
    private DotNetObjectReference<Home>? _dotNetRef;
    private bool _calendarOpen;
    private DateTime _calendarMonth = DateTime.Today;

    private CategoryDto[] _allCategories = [];
    private Dictionary<int, CategoryDto> _categoryById = [];
    private Dictionary<string, int[]> _groupCategories = [];
    private Dictionary<DateOnly, int> _photoCounts = [];
    private int? _selectedCategoryId;
    private string? _assigningGroupId;
    private string _categoryInput = "";

    protected override async Task OnInitializedAsync()
    {
        await Auth.CheckAsync();
        if (Auth.State.IsAuthenticated)
        {
            await ReloadAsync();

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/photos"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On("PhotosChanged", async () =>
            {
                await ReloadAsync();
                await InvokeAsync(StateHasChanged);
            });

            try { await _hubConnection.StartAsync(); }
            catch (Exception ex) { Logger.LogWarning(ex, "SignalR hub connection failed; real-time updates unavailable"); }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _touchModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/touch-drag.js");
            await _touchModule.InvokeVoidAsync("init", _dotNetRef);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"touch-drag init failed: {ex.Message}");
            _touchModule = null;
        }
    }

    [JSInvokable]
    public async Task DropOnFromTouch(string sourceName, string targetName)
    {
        if (await Photos.GroupAsync(sourceName, targetName))
        {
            await RefreshGroupsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task DropIntoGroupFromTouch(string sourceName, string targetGroupId)
    {
        if (await Photos.MovePhotoToGroupAsync(sourceName, targetGroupId))
        {
            await RefreshGroupsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadFirstPage(DateOnly? date = null)
    {
        _photos = null;
        _nextBefore = null;
        var page = await Photos.LoadPageAsync(date: date);
        _photos = [..page.Items];
        _nextBefore = page.NextBefore;
    }

    private async Task LoadMoreAsync()
    {
        if (_nextBefore is null || _loadingMore) return;
        _loadingMore = true;
        try
        {
            var date = _selectedDay.HasValue ? DateOnly.FromDateTime(_selectedDay.Value) : (DateOnly?)null;
            var page = await Photos.LoadPageAsync(before: _nextBefore, date: date);
            _photos!.AddRange(page.Items);
            _photosByName = _photos.ToDictionary(photo => photo.Name, StringComparer.Ordinal);
            _nextBefore = page.NextBefore;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task ReloadAsync()
    {
        var date = _selectedDay.HasValue ? DateOnly.FromDateTime(_selectedDay.Value) : (DateOnly?)null;
        await LoadFirstPage(date);
        _groupTree = await Photos.LoadGroupTreeAsync();
        _childrenByParent = _groupTree
            .Where(node => !string.IsNullOrWhiteSpace(node.ParentGroupId))
            .GroupBy(node => node.ParentGroupId!)
            .ToDictionary(g => g.Key, g => g.ToArray());
        _photosByName = (_photos ?? [])
            .ToDictionary(photo => photo.Name, StringComparer.Ordinal);
        _allCategories = await Photos.LoadCategoriesAsync();
        _categoryById = _allCategories.ToDictionary(c => c.Id);
        _groupCategories = await Photos.LoadGroupCategoriesAsync();
        _photoCounts = await Photos.LoadPhotoCountsAsync();
    }

    private async Task RefreshGroupsAsync()
    {
        _groupTree = await Photos.LoadGroupTreeAsync();
        _childrenByParent = _groupTree
            .Where(node => !string.IsNullOrWhiteSpace(node.ParentGroupId))
            .GroupBy(node => node.ParentGroupId!)
            .ToDictionary(g => g.Key, g => g.ToArray());
        _groupCategories = await Photos.LoadGroupCategoriesAsync();
        _allCategories = await Photos.LoadCategoriesAsync();
        _categoryById = _allCategories.ToDictionary(c => c.Id);
    }

    private bool HasVisiblePhotos(GroupTreeNodeDto node) =>
        GroupPhotos(node).Length > 0
        || ChildGroups(node.GroupId).Any(HasVisiblePhotos);

    private GroupTreeNodeDto[] RootGroups() =>
        _groupTree
            .Where(node =>
                string.IsNullOrWhiteSpace(node.ParentGroupId)
                && IsGroupVisible(node.GroupId)
                && HasVisiblePhotos(node))
            .Select(node => new { node, photos = GroupPhotos(node) })
            .OrderByDescending(x => x.photos.Length > 0
                ? x.photos[0].LastModified
                : DateTimeOffset.MinValue)
            .Select(x => x.node)
            .ToArray();

    private GroupTreeNodeDto[] ChildGroups(string groupId) =>
        _childrenByParent.TryGetValue(groupId, out var children)
            ? children
            : [];

    private PhotoInfo[] GroupPhotos(GroupTreeNodeDto node) =>
        node.Photos
            .Where(_photosByName.ContainsKey)
            .Select(name => _photosByName[name])
            .OrderByDescending(photo => photo.LastModified)
            .ToArray();

    private bool IsGroupVisible(string groupId)
    {
        if (_selectedCategoryId is null) return true;

        var selectedCategoryId = _selectedCategoryId.Value;
        var ownMatch =
            _groupCategories.TryGetValue(groupId, out var ownCats)
            && ownCats.Contains(selectedCategoryId);
        if (ownMatch) return true;

        var children = _childrenByParent.TryGetValue(groupId, out var c) ? c : [];
        return children.Any(child => IsGroupVisible(child.GroupId));
    }

    private PhotoInfo[] UngroupedPhotos()
    {
        // When filtering by category, hide ungrouped photos entirely
        if (_selectedCategoryId is not null) return [];

        var groupedNames = _groupTree
            .SelectMany(group => group.Photos)
            .ToHashSet(StringComparer.Ordinal);

        return VisiblePhotos()
            .Where(photo => !groupedNames.Contains(photo.Name))
            .OrderByDescending(photo => photo.LastModified)
            .ToArray();
    }

    private PhotoInfo[] VisiblePhotos() => _photos?.ToArray() ?? [];

    private static DateTime PhotoDate(PhotoInfo photo)
    {
        if (photo.Name.Length >= 8
            && DateTime.TryParseExact(
                photo.Name[..8],
                "yyyyMMdd",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var fromName))
        {
            return fromName.Date;
        }

        return photo.LastModified.ToLocalTime().Date;
    }

    private string CalendarButtonLabel()
    {
        if (_selectedDay is not null)
            return _selectedDay.Value.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
        return "Calendar";
    }

    private void ToggleCalendar() => _calendarOpen = !_calendarOpen;

    private void PrevMonth() => _calendarMonth = _calendarMonth.AddMonths(-1);
    private void NextMonth() => _calendarMonth = _calendarMonth.AddMonths(1);

    private DateTime?[] CalendarCells()
    {
        var first = new DateTime(_calendarMonth.Year, _calendarMonth.Month, 1);
        var offset = ((int)first.DayOfWeek + 6) % 7;
        var daysInMonth = DateTime.DaysInMonth(first.Year, first.Month);
        var cells = new DateTime?[offset + daysInMonth];
        for (var i = 0; i < offset; i++) cells[i] = null;
        for (var d = 1; d <= daysInMonth; d++) cells[offset + d - 1] = new DateTime(first.Year, first.Month, d);
        return cells;
    }

    private int GetPhotoCount(DateTime day) =>
        _photoCounts.TryGetValue(DateOnly.FromDateTime(day), out var count) ? count : 0;

    private static string DayStyle(bool isSelected, bool hasPhotos)
    {
        var baseStyle = "all: unset; width: 32px; height: 38px; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 8px; font-size: 0.85rem; box-sizing: border-box; cursor: pointer; position: relative; gap: 0;";
        if (isSelected)
            return baseStyle + " background: #1d4ed8; color: #fff; font-weight: 700;";
        if (hasPhotos)
            return baseStyle + " background: #e0f2fe; color: #0284c7; font-weight: 600;";
        return baseStyle + " color: #1f2937;";
    }

    private async Task SelectDate(DateTime? day)
    {
        _selectedDay = day?.Date;
        if (day is not null)
        {
            _calendarMonth = new DateTime(day.Value.Year, day.Value.Month, 1);
            _calendarOpen = false;
        }
        await ReloadAsync();
    }

    private void OpenLightbox(PhotoInfo photo)
    {
        if (!string.IsNullOrWhiteSpace(_draggedPhotoName)) return;
        _lightboxPhoto = photo;
    }

    private void CloseLightbox()
    {
        _lightboxPhoto = null;
    }

    private void StartDrag(string photoName)
    {
        _draggedPhotoName = photoName;
    }

    private void EndDrag()
    {
        _draggedPhotoName = null;
    }

    private async Task DropOn(string targetName)
    {
        if (string.IsNullOrWhiteSpace(_draggedPhotoName) || _draggedPhotoName == targetName)
        {
            _draggedPhotoName = null;
            return;
        }

        var sourceName = _draggedPhotoName;
        _draggedPhotoName = null;

        if (await Photos.GroupAsync(sourceName, targetName))
        {
            await RefreshGroupsAsync();
        }
    }

    private async Task DropIntoGroup(string targetGroupId)
    {
        if (string.IsNullOrWhiteSpace(_draggedPhotoName))
        {
            _draggedPhotoName = null;
            return;
        }

        var sourceName = _draggedPhotoName;
        _draggedPhotoName = null;

        if (await Photos.MovePhotoToGroupAsync(sourceName, targetGroupId))
        {
            await RefreshGroupsAsync();
        }
    }

    private async Task DeletePhoto(PhotoInfo photo)
    {
        if (await Photos.DeleteAsync(photo.Name))
        {
            _photos?.RemoveAll(p => p.Name == photo.Name);
            _photosByName.Remove(photo.Name);
            await ReloadAsync();
        }
    }

    private async Task UngroupPhoto(PhotoInfo photo)
    {
        if (await Photos.UngroupAsync(photo.Name))
        {
            await RefreshGroupsAsync();
        }
    }

    private string[] GetGroupCategoryNames(string groupId)
    {
        if (string.IsNullOrEmpty(groupId)) return [];
        if (!_groupCategories.TryGetValue(groupId, out var catIds)) return [];
        return catIds.Where(_categoryById.ContainsKey).Select(id => _categoryById[id].Name).ToArray();
    }

    private CategoryDto[] GetGroupCategories(string groupId)
    {
        if (string.IsNullOrEmpty(groupId)) return [];
        if (!_groupCategories.TryGetValue(groupId, out var catIds)) return [];
        return catIds.Where(_categoryById.ContainsKey).Select(id => _categoryById[id]).ToArray();
    }

    private void StartAssigningCategory(string groupId)
    {
        _assigningGroupId = groupId;
        _categoryInput = "";
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(_assigningGroupId) || string.IsNullOrWhiteSpace(_categoryInput)) return;
        if (await Photos.AssignCategoryAsync(_assigningGroupId, _categoryInput.Trim()))
        {
            _assigningGroupId = null;
            _categoryInput = "";
            await RefreshGroupsAsync();
        }
    }

    private async Task OnCategoryKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveCategory();
        if (e.Key == "Escape") _assigningGroupId = null;
    }

    private async Task RemoveGroupCategory(string groupId, int categoryId)
    {
        if (await Photos.RemoveCategoryAsync(groupId, categoryId))
        {
            await RefreshGroupsAsync();
        }
    }

    private async Task ClearFilters()
    {
        _selectedDay = null;
        _selectedCategoryId = null;
        await ReloadAsync();
    }

    private async Task OnCategoryFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _selectedCategoryId = int.TryParse(val, out var id) ? id : null;
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_touchModule is not null)
        {
            await _touchModule.InvokeVoidAsync("dispose");
            await _touchModule.DisposeAsync();
        }
        _dotNetRef?.Dispose();
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
