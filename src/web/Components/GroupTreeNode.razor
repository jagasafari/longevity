@using web.Services

@if (IsVisible(Node.GroupId))
{
    <section class="group-section nested-group" style="--depth:@Depth"
             data-group-id="@Node.GroupId"
             @ondragover:preventDefault
             @ondrop="() => DropIntoGroup(Node.GroupId)">
        <h3>Subgroup</h3>

        @{
            var nodePhotos = NodePhotos();
        }
        @if (nodePhotos.Length > 0)
        {
            <div class="photo-grid">
                @foreach (var photo in nodePhotos)
                {
                    <PhotoCard Photo="photo"
                               ShowUngroup="true"
                               OnStartDrag="EventCallback.Factory.Create<string>(this, StartDrag)"
                               OnEndDrag="EventCallback.Factory.Create(this, EndDrag)"
                               OnDrop="EventCallback.Factory.Create<string>(this, DropOnPhoto)"
                               OnClick="OnOpenLightbox"
                               OnUngroup="EventCallback.Factory.Create<PhotoInfo>(this, Ungroup)"
                               OnDelete="EventCallback.Factory.Create<PhotoInfo>(this, Delete)" />
                }
            </div>
        }

        @if (Children(Node.GroupId).Length > 0)
        {
            <div class="subgroups-container">
                @foreach (var child in Children(Node.GroupId))
                {
                    <GroupTreeNode Node="child"
                                   Depth="@(Depth + 1)"
                                   PhotosByName="PhotosByName"
                                   ChildrenByParent="ChildrenByParent"
                                   IsVisible="IsVisible"
                                   OnStartDrag="OnStartDrag"
                                   OnEndDrag="OnEndDrag"
                                   OnDropOnPhoto="OnDropOnPhoto"
                                   OnDropIntoGroup="OnDropIntoGroup"
                                   OnOpenLightbox="OnOpenLightbox"
                                   OnUngroup="OnUngroup"
                                   OnDelete="OnDelete" />
                }
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired]
    public GroupTreeNodeDto Node { get; set; } = default!;

    [Parameter]
    public int Depth { get; set; } = 1;

    [Parameter, EditorRequired]
    public Dictionary<string, PhotoInfo> PhotosByName { get; set; } = [];

    [Parameter, EditorRequired]
    public Dictionary<string, GroupTreeNodeDto[]> ChildrenByParent { get; set; } = [];

    [Parameter, EditorRequired]
    public Func<string, bool> IsVisible { get; set; } = _ => true;

    [Parameter, EditorRequired]
    public Action<string> OnStartDrag { get; set; } = _ => { };

    [Parameter, EditorRequired]
    public Action OnEndDrag { get; set; } = () => { };

    [Parameter, EditorRequired]
    public Func<string, Task> OnDropOnPhoto { get; set; } = _ => Task.CompletedTask;

    [Parameter, EditorRequired]
    public Func<string, Task> OnDropIntoGroup { get; set; } = _ => Task.CompletedTask;

    [Parameter, EditorRequired]
    public EventCallback<PhotoInfo> OnOpenLightbox { get; set; }

    [Parameter, EditorRequired]
    public Func<PhotoInfo, Task> OnUngroup { get; set; } = _ => Task.CompletedTask;

    [Parameter, EditorRequired]
    public Func<PhotoInfo, Task> OnDelete { get; set; } = _ => Task.CompletedTask;

    private PhotoInfo[] NodePhotos() =>
        Node.Photos
            .Where(PhotosByName.ContainsKey)
            .Select(name => PhotosByName[name])
            .OrderByDescending(photo => photo.LastModified)
            .ToArray();

    private GroupTreeNodeDto[] Children(string groupId) =>
        ChildrenByParent.TryGetValue(groupId, out var children)
            ? children
            : [];

    private void StartDrag(string name) => OnStartDrag(name);

    private void EndDrag() => OnEndDrag();

    private Task DropOnPhoto(string targetName) => OnDropOnPhoto(targetName);

    private Task DropIntoGroup(string groupId) => OnDropIntoGroup(groupId);

    private Task OpenLightbox(PhotoInfo photo) => OnOpenLightbox.InvokeAsync(photo);

    private Task Ungroup(PhotoInfo photo) => OnUngroup(photo);

    private Task Delete(PhotoInfo photo) => OnDelete(photo);
}
