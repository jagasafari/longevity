# Ignore build outputs and IDE files
bin/
obj/
.vs/
.vscode/
*.user
*.swp
.DS_Store

# Ignore publish output
**/bin/
**/obj/
**/wwwroot/lib/

# User-specific launch settings
**/Properties/launchSettings.json

# Environment-specific appsettings
appsettings.Development.json
appsettings.*.json
!appsettings.json

# Ignore temporary files
**/*.tmp
**/*.cache

# Ignore logs
*.log

# Ignore OS files
Thumbs.db

# Ignore compressed files
*.zip
*.tar.gz
*.tgz
*.7z

# Ignore Rider/JetBrains IDE files
.idea/

# Ignore static web assets cache
**/staticwebassets/

# Ignore scopedcss bundles
**/scopedcss/

# Ignore webcil and tmp-webcil
**/webcil/
**/tmp-webcil/

# Generated workbook payload
infra/azure/modules/workbook.serialized.json

# Local Bicep build output
infra/azure/modules/workbook.json

# Local environment config (contains PII / env-specific values — never commit)
infra/scripts/env.json

.local

# Local working files
/500
/downloads/

# Postgres backups contain personal data — keep local only
backups/postgres/*.sql
