LongevityApp/obj/**/staticwebassets/
# Ignore scopedcss bundles
LongevityApp/obj/**/scopedcss/
# Ignore webcil and tmp-webcil
LongevityApp/obj/**/webcil/
LongevityApp/obj/**/tmp-webcil/
